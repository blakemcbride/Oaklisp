;;; The access interface is PRESENT?, same as for SAT-TREEs.  Returns
;;; a PAIR whose CAR is the key and whose CDR is the associated value.

;;; A different interface to hash tables is provided by the T-style
;;; TABLE-ENTRY operation which returns the associated value or #f if
;;; the key isn't in the table.

;;; The setter of either operation can be used to add, modify, and
;;; remove associations.

;;; Set PRESENT? to a new value, not a (key . val) pair.


;(define-instance present? settable-operation)
;(define-instance table-entry settable-operation)

(define-instance hash-table type '() '())



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;    generic hash tables


(define-instance generic-hash-table
  type '(table count size key-op =?) (list hash-table object))


(add-method (initialize (generic-hash-table key-op =? table count size)
			self the-key-op the-=?)
  (set! key-op the-key-op)
  (set! =? the-=?)
  (set! count 0)
  (set! size 17)
  (set! table (make simple-vector size))
  (dotimes (i size) (set! (nth table i) '()))
  self)



;;; A reader takes the table vector once and sizes its index by it, so
;;; it always sees one complete table: RESIZE fills the new vector
;;; before installing it, an insert replaces a bucket's list in one
;;; store, and a removal builds a new list.  So lookups are safe
;;; against a writer in another thread (the runtime's tables are
;;; written under their mutexes); writers against each other are not.

(add-method (present? (generic-hash-table key-op =? table count size) self x)
  (let ((t table))
    (ass =? x (nth t (modulo (key-op x) (length t))))))

(add-method ((setter present?) (generic-hash-table key-op =? table count size)
			       self x v)
  (let* ((key (key-op x))
	 (index (modulo key size))
	 (lslot (make-locative (nth table index)))
	 (slot (contents lslot))
	 (entry (ass =? x slot)))
    (if v
	(if entry
	    (set! (cdr entry) v)	;modify
	    (block			;insert
	      (set! (contents lslot)
		    (cons (cons x v) slot))
	      (set! count (+ count 1))
	      (when (> (+ count count) size)
		(resize self (+ 1 (+ size size))))))

	(when entry			;remove
	  (set! (contents lslot)
		(del (lambda (k p) (=? k (car p))) x slot))
	  (set! count (- count 1)))))
  v)



(define-instance resize operation)

(add-method (resize (generic-hash-table key-op table count size) self new-size)
  (let ((old-table table)
	(old-size size)
	(new-table (make simple-vector new-size)))
    (dotimes (i new-size)
      (set! (nth new-table i) '()))
    (dotimes (i old-size)
      (dolist (entry (nth old-table i))
	(let* ((key (key-op (car entry)))
	       (j (modulo key new-size))
	       (jloc (make-locative (nth new-table j))))
	  (set! (contents jloc) (cons entry (contents jloc))))))
    (set! table new-table)
    (set! size new-size)
    self))


;;; String hash tables:


(define-instance string-hash-key operation)

#||
(add-method (string-hash-key (string char-count) s)
  (iterate aux ((i 0) (k 0))
    (if (= i char-count) k
	(aux (+ i 1)
	     (bit-xor (rot-left k 7)
		      (%character->fixnum (nth s i)))))))
||#

;;; Maybe the following will speed up reading:

;;; The bytes of the last word above character CHAR-COUNT are padding
;;; and belong to no character, so they are masked off before they reach
;;; the hash.  STRING-GUTS-EQUAL? in strings.oak masks the same word the
;;; same way; the two have to agree, or EQUAL? strings would land in
;;; different buckets.

(add-method (string-hash-key (string char-count) s)
  (if (eq? char-count 0) 0
      (let ((n (quotient (+ char-count (- %chars-per-word 1)) %chars-per-word))
	    (last-mask (%string-last-word-mask char-count))
	    (p0 (make-locative (%vref s 0))))
	(iterate aux ((i 0) (k 0))
	  (if (= i n) k
	      (aux (+ i 1)
		   (bit-xor (rot-left k (- (* 8 %chars-per-word) 1))
			    (let ((w (contents (%increment-locative p0 i))))
			      (if (= i (- n 1))
				  (bit-and last-mask w)
				  w)))))))))



(define (make-string-hash-table)
  (make generic-hash-table string-hash-key equal?))



;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;    EQ? hash tables


(define-instance eq-hash-table
  type '(table count size) (list hash-table object))

;;; Fixnums and the other immediates (characters, weak pointers) never
;;; move, so they hash on their own bits.  Only a heap object needs
;;; OBJECT-HASH, whose weak pointer follows it when the collector moves
;;; it.  For an immediate, OBJECT-HASH would probe the global
;;; weak-pointer table on every call and add an entry, never freed, for
;;; each new key.

(local-syntax (eq-hash-key x)
  (let ((k (genvar)))
    `(let ((,k ,x))
       (cond ((eq? (%tag ,k) %fixnum-tag) ,k)
	     ((eq? (%tag ,k) %immediate-tag) (%data ,k))
	     (else (object-hash ,k))))))

;;; TABLE is a vector of SIZE buckets, each an alist of entries (KEY .
;;; VALUE) -- the pairs PRESENT? answers, which a caller may keep and
;;; change -- the newest first.  Programs walk these ivars themselves
;;; (doc/examples/unit-testing.oak), so this layout is part of the
;;; interface.  The buckets are worked on by operations on the vector
;;; itself, through %LOAD-BP-I, rather than one NTH or locative at a
;;; time; the vector's length is read as LENGTH's method for it would.

(let ((bucket (make operation))
      (bucket-set (make operation))
      (fill (make operation))
      (move (make operation))
      (push-entry (make operation)))

  ;; KEY's bucket in the buckets SELF.
  (add-method (bucket (variable-length-mixin) self key)
    (%load-bp-i (modulo (eq-hash-key key)
			(- ((%slot 1) self) ((%slot 1) (get-type self))))))

  ;; (SETTER PRESENT?) on the buckets SELF: the change in the count.
  (add-method (bucket-set (variable-length-mixin) self x v)
    (let* ((i (modulo (eq-hash-key x)
		      (- ((%slot 1) self) ((%slot 1) (get-type self)))))
	   (slot (%load-bp-i i))
	   (entry (%assq x slot)))
      (if v
	  (if entry
	      (block (set! (cdr entry) v) 0)		;modify
	      (block					;insert
		(set! (%load-bp-i i) (cons (cons x v) slot))
		1))
	  (if entry
	      (block					;remove
		(set! (%load-bp-i i)
		      (del (lambda (k p) (eq? k (car p))) x slot))
		-1)
	      0))))					;noop

  (add-method (fill (variable-length-mixin) self n)
    (dotimes (i n)
      (set! (%load-bp-i i) '())))

  ;; The entries of the N buckets SELF onto the front of the buckets
  ;; NEW, of which there are NEW-SIZE, in order.
  (add-method (move (variable-length-mixin) self n new new-size)
    (dotimes (i n)
      (dolist (entry (%load-bp-i i))
	(push-entry new (modulo (eq-hash-key (car entry)) new-size) entry))))

  (add-method (push-entry (variable-length-mixin) self j entry)
    (set! (%load-bp-i j) (cons entry (%load-bp-i j))))

  (add-method (initialize (eq-hash-table table count size) self)
    (let ((t (make simple-vector 17)))
      (fill t 17)
      (set! count 0)
      (set! size 17)
      (set! table t))
    self)

  (add-method (present? (eq-hash-table table) self x)
    (%assq x (bucket table x)))

  (add-method ((setter present?) (eq-hash-table table count size) self x v)
    (let ((d (bucket-set table x v)))
      (unless (eq? d 0)
	(set! count (+ count d))
	(when (and (eq? d 1) (> (+ count count) size))
	  (resize self (+ 1 (+ size size))))))
    v)

  (add-method (resize (eq-hash-table table count size) self new-size)
    (let ((old-table table)
	  (old-size size)
	  (new-table (make simple-vector new-size)))
      (fill new-table new-size)
      (move old-table old-size new-table new-size)
      (set! table new-table)
      (set! size new-size)
      self)))

(define (make-eq-hash-table) (make eq-hash-table))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;   EQUAL-HASH-TABLE

(define (tree-hash x)
  (tree-hash-aux x 0))

;;; The fallback hash for anything TREE-HASH-AUX does not take apart
;;; itself.  OBJECT-HASH, the default method, is object identity, which
;;; agrees with EQUAL? for immediates and for interned symbols but not
;;; for any boxed object whose EQUAL? compares values -- a bignum, a
;;; fraction, a complex number, or a user type with its own EQUAL?
;;; method.  Such a type has to add a method here as well, or two keys
;;; EQUAL? to each other will hash into different buckets and an
;;; EQUAL-HASH-TABLE will never find the entry it holds.  The numeric
;;; types do so where they are defined; see bignum.oak, rational.oak and
;;; complex.oak.  Whenever an EQUAL? method changes, this has to change
;;; with it.

(define-instance hash-key operation)

(add-method (hash-key (object) x)
  (object-hash x))

(define (tree-hash-aux x d)
  (cond ((= d 4) #x162534)
	((pair? x) (bit-xor (tree-hash-aux (car x) (+ d 1))
			    (rot-left (tree-hash-aux (cdr x) (+ d 1)) 17)))
	((string? x) (string-hash-key x))
	((vector? x) (vector-hash-key-aux x d))
	(else (hash-key x))))

(define (vector-hash-key-aux x d)
  (let ((l (length x)))
    ;; First clause is not portable--relies on uniqueness of the empty vector.
    (cond ((zero? l) (object-hash x))
	  (else (bit-xor
		 (bit-xor (rot-left l 23)
			  (rot-left (tree-hash-aux (nth x 0) (+ d 1)) 17))
		 (bit-xor (rot-left (tree-hash-aux (nth x (modulo 7 l)) (+ d 1)) 11)
			  (tree-hash-aux (nth x (modulo 39 l)) (+ d 1))))))))

(define-instance equal-hash-table type '() (list generic-hash-table))

(add-method (initialize (equal-hash-table) self)
  (^super generic-hash-table initialize self tree-hash equal?))

(define (make-equal-hash-table) (make equal-hash-table))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;   shared methods


(add-method (print (hash-table) self stream)
  (format stream "#<hash-table ~D ~!>" (length self) self))

(dolist (typ (list generic-hash-table eq-hash-table))

  (add-method (length (typ count) self)
    count)

  (add-method (#^list-type (typ table size) self)
    (iterate aux ((i 0)(l '()))
      (if (= i size) l
	  (aux (+ i 1) (append (nth table i) l)))))

  (add-method ((setter length) (typ table count size) self new-length)
    (when (!= new-length 0)
      (error "Attempt to set hash table ~S to non-zero length." self))
    (set! count 0)
    (dotimes (i size)
      (set! (nth table i) '())))

  )


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;  table-entry interface, like in T


(define-instance table-entry settable-operation)

(set! (setter table-entry) (setter present?))

(add-method (table-entry (hash-table) tab key)
  (cond ((present? tab key) => cdr)
	(else #f)))


