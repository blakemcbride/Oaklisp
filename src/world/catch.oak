;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;appropriate types and operations;;;;;;;;;

(define-instance escape-object
  type '(value-stack-offset		;These stack offsets are manipulated
	 context-stack-offset		; only by the micro-engine.

	 saved-wind-count
	 saved-fluid-binding-list)
  (list object))

(%your-top-wired escape-object)

(define-constant %escape-object-length 5)



;;; The fourth slot holds (fluid-bindings . process) of the catch.  A
;;; throw from another process (an error in a forced promise, handled
;;; by the forcer's CATCH-ERRORS) first unwinds the thrower's own
;;; windings as the thrower, then makes the catcher the current
;;; process again and unwinds its windings down to the catch: each
;;; process's winding thunks run as that process, which is what holds
;;; its mutexes.  (The slot is a pair rather than a new slot because
;;; %ESCAPE-OBJECT-LENGTH is a frozen constant, inlined by the
;;; compiling world: the object cannot grow in a bootstrap.)

(define throw
  (add-method ((make operation)
	       (escape-object saved-wind-count saved-fluid-binding-list)
	       tag value)
    (let* ((saved saved-fluid-binding-list)
	   ;; NATIVE-CATCH is a macro, so in a bootstrap pass whose
	   ;; compiling world has the older one, every other file's
	   ;; catches store the bindings list alone; its cdr is a list
	   ;; or nil, never a process or 0.
	   (new? (and (pair? saved)
		      (not (null? (cdr saved)))
		      (not (pair? (cdr saved)))))
	   (bindings (if new? (car saved) saved))
	   (saved-process (if new? (cdr saved) 0))
	   (here (%load-process)))
      (unless (or (eq? here saved-process)
		  (eq? here 0)
		  (eq? saved-process 0))
	(unwind (current-windings) (current-wind-count)
		(process-base-wind-count here))
	(%store-process saved-process))
      (unwind (current-windings) (current-wind-count) saved-wind-count)
      (set-current-fluid-bindings bindings)
      (%throw tag value))))

(define-constant %throw
  (add-method ((make-open-coded-operation '((throw)) 2 1)
	       (escape-object) tag value)
    (%throw tag value)))

;;; The THROW instruction traps when its tag is not a pointer, and when
;;; the stack heights recorded in the escape object are not heights the
;;; current stacks could have.  The handler must not be %THROW itself:
;;; %THROW's method for an escape object is that very instruction, so a
;;; bad height would trap again forever.  This is the same trap the
;;; table in tag-trap.oak avoids for slots 11, 25 and 53; it lives here
;;; only because %THROW does not exist that early in the cold load.

(set! (nth %argless-tag-trap-table 48)
      (lambda (tag value)
	(error "Illegal args (%THROW ~S ~S).~%" tag value)))

;;; %FILLTAG can never be actually called without losing, only the
;;; open coded version works, so we don't bother with a method for it.

(define-constant %filltag
  (make-open-coded-operation
   (lambda (ignore)
     `((filltag
	,#*filltag-offset)))	;info from the compiler
   1 1))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;;;;;;;;how catch should be compiled;;;;;;;;;;;

(define-syntax (native-catch var . body)
  `(%catch
    (let ((,var (%filltag
		 (%allocate escape-object %escape-object-length))))
      (set! ((%slot 3) ,var) (current-wind-count))
      (set! ((%slot 4) ,var) (cons (get-current-fluid-bindings) (%load-process)))
      ,@body)))

(define-syntax (catch v . body)
  `(native-catch ,v
     (let ((,v (lambda (val) (throw ,v val))))
       ,@body)))



;;; The following method occurs in mac-code.  I am showing it here so
;;; that its relationship to the NATIVE-CATCH macro and the %FILLTAG
;;; open coder will be clear.

#||
(add-method (gen-code (ast-catch-node expression) self cont)
  (let ((end-cont (if (eq? cont 'next) (gensym "endcatch") cont)))
    (let* ((body-code
	    (bind ((#*barrier-node
		    (if (eq? cont 'tail)
			#*barrier-node
			(combn-op expression))) ;the LET lambda
		   (#*filltag-offset
		    (1+ (if (eq? cont 'tail)
			    (nguys-to-pop self)
			    0))))
	      (gen-code expression 'tail))))
      (splice
       (list (if (eq? end-cont 'tail) '() (list `(push-cxt ,end-cont)))
	     body-code
	     (if (eq? cont 'next) (list end-cont) '()))))))
||#
