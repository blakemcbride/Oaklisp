;;; queue.oak

(define (make-queue)
  (list '()))

(define (enqueue obj q)
  (if (null? (car q))
      (block (set! (car q) (list obj))
	     (set! (cdr q) (car q)))
      (block (set! (cdr (cdr q)) (list obj))
	     (set! (cdr q) (cdr (cdr q)))))
  (car q))


(define (dequeue q)
  (pop (car q)))

(define (qappend q1 q2)
  (if (not (null? (car q2)))
      (block (set! (car q1) (append (car q1) (car q2)))
	     (set! (cdr q1) (cdr q2))))
  (car q1))

(define (qempty? q)
  (null? (car q)))

;;; potpourri.oak

(set! #*fancy-references #t)

(define-syntax (until test . body)
  `(labels ((fn (lambda ()
	       ,@body
	       (if ,test #t (fn)))))
     (fn)))

;;; process.oak

;;; This is the initial process object class. The current-process
;;; object is stored in a register of the virtual machine for uniform
;;; access from the task code independant of which virtual machine
;;; (i.e. pthread) is running the task.

;;; Process ids come from NEW-PID (below), lock-free; the first process
;;; of a run gets the global fluid bindings, every later one a copy of
;;; its creator's.

(define-instance process type
  '(pid process-fluid-binding-list windings wind-count pending-rewind
    base-wind-count)
  (list object))
(define-instance process-id operation)
(define-instance fluid-bindings settable-operation)
(define-instance copy-fluid-bindings operation)

;;; A process's winding stack (unwind-protect.oak).
(define-instance process-windings settable-operation)
(define-instance process-wind-count settable-operation)
(define-instance process-pending-rewind settable-operation)

(add-method (process-windings (process windings) self) windings)
(add-method ((setter process-windings) (process windings) self new)
  (set! windings new))
(add-method (process-wind-count (process wind-count) self) wind-count)
(add-method ((setter process-wind-count) (process wind-count) self new)
  (set! wind-count new))
(add-method (process-pending-rewind (process pending-rewind) self)
  pending-rewind)
;;; The wind count the process started with (its creator's): below it
;;; the winding stack is the creator's, above it the process's own.
(define-instance process-base-wind-count operation)
(add-method (process-base-wind-count (process base-wind-count) self)
  base-wind-count)
(add-method ((setter process-pending-rewind) (process pending-rewind) self new)
  (set! pending-rewind new))

;;; %PUSH-WINDING and %POP-WINDING (unwind-protect.oak) in one method
;;; each: the guarded sections and WIND-PROTECT do nothing else as
;;; often.
(define-instance %process-push-winding operation)
(define-instance %process-pop-winding operation)
(add-method (%process-push-winding (process windings wind-count) self item)
  (set! windings (cons item windings))
  (set! wind-count (+ wind-count 1)))
(add-method (%process-pop-winding (process windings wind-count) self)
  (set! windings (cdr windings))
  (set! wind-count (- wind-count 1)))

;;; The process of a thread made by MAKE-THREAD (below) is pinned to
;;; its OS thread: the bottom of its stack is that thread's exit, so it
;;; must never be resumed on another.  It never goes on the scheduler's
;;; queue: PAUSE only yields the OS thread, and waiting for a mutex, a
;;; future or a semaphore parks it.
(define-instance pinned-process type '() (list process))
(define-instance %process-pinned? operation)
(add-method (%process-pinned? (object) self) #f)
(add-method (%process-pinned? (pinned-process) self) #t)

(define trace-processes #f)

(add-method (initialize (process pid process-fluid-binding-list
				  windings wind-count pending-rewind
				  base-wind-count) self)
  (when trace-processes
     (format #t "init: oak process descriptor~%"))
  (set! pid (new-pid))
  ;; A copy of the creator's bindings: the global list when there is
  ;; no process yet (the first one, at warm boot).
  (set! process-fluid-binding-list
	(map (lambda (z) (cons (car z) (cdr z)))
	     (get-current-fluid-bindings)))
  ;; And the creator's winding stack as it stands: the new process's
  ;; dynamic extent begins inside its creator's, so a throw from it
  ;; to a catch of the creator's (an error in a forced promise,
  ;; handled by the forcer) unwinds down to that catch's level.  The
  ;; list is shared and never mutated: unwinding replaces the head.
  (set! windings (current-windings))
  (set! wind-count (current-wind-count))
  (set! base-wind-count wind-count)
  (set! pending-rewind #f)
  self)

(add-method (process-id (process pid) self)
  pid)

(define (current-process)
  (%load-process))

(add-method (fluid-bindings (process process-fluid-binding-list) self)
  process-fluid-binding-list)

(add-method ((setter fluid-bindings) (process process-fluid-binding-list)
	     self new-fluid-binding-list)
  (set! process-fluid-binding-list new-fluid-binding-list))

(add-method (copy-fluid-bindings (process process-fluid-binding-list) self)
  (map (lambda (z) (cons (car z) (cdr z)))
       process-fluid-binding-list))

;;; mutex.oak

;;; A solution to the critical section problem for multiple
;;; asynchronous processes, which must have shared access to a set of
;;; access flags and a contended turn value.

;;; This is supposed to be used to build higher-level access control
;;; objects, so that the amount of time spent using the lock to achive
;;; something is small and so processes will not have to be in busy
;;; waiting for very long.

;;; In practice, if we get this system running across multiple
;;; processors and have a situation that we don't expect to tkae very
;;; long to resolve, this may be adequate because the waiting process
;;; on another processor will not have to context switch itself out
;;; and back in because of being put on some waiting list.

;;; A process had better not release a mutex it has not acuired, for
;;; obvious reasons.

;;; This implementation uses a low-level %TEST-AND-SET-LOCATIVE opcode
;;; which is atomic.  The mutex has a location that controls access to
;;; the critical section between an arbitrary number of asynchronous
;;; tasks, which is important in a future system with no reasonable
;;; bounds on the number of processes.

;;; A mutex is held by a process and is reentrant: ACQUIRE-MUTEX by the
;;; holder counts, and RELEASE-MUTEX by anyone else is an error.  The
;;; holder is the process rather than the OS thread because a
;;; lightweight process can be preempted inside a critical section and
;;; resume on another thread, while another process running meanwhile
;;; on the first thread must not be taken for the holder.  The
;;; scheduler's own lock is the exception (%THREAD-MUTEX): its section
;;; switches processes, but runs with alarms off, so it never leaves
;;; its thread.  A mutex may have a name, and a process that has waited
;;; MUTEX-REPORT-SPINS steps, or MUTEX-REPORT-MS milliseconds parked,
;;; says so on standard error, naming the mutex and its holder, which
;;; is how a deadlock shows itself.  WITH-MUTEX (below) releases on any
;;; exit.
;;;
;;; The access-cons is the lock word: its car the held flag, taken with
;;; %TEST-AND-SET-LOCATIVE, its cdr the OS threads (by %THREAD-INDEX)
;;; parked waiting for the mutex, kept with the same primitive.  A
;;; process that finds the mutex held does not spin: each step of its
;;; wait is a %MUTEX-WAIT (after the scheduler, below), which runs the
;;; processes the scheduler has queued, the holder perhaps among them,
;;; or parks the OS thread until RELEASE-MUTEX unparks it.

(define-instance mutex type
  '(access-cons owner depth name acquire-thunk release-thunk) (list object))

(define-instance acquire-mutex operation)
(define-instance release-mutex operation)
(define-instance mutex-name settable-operation)
(define-instance %mutex-self operation)
(define-instance %mutex-owner operation)
(define-instance %mutex-wait operation)
(define-instance %mutex-acquire-thunk operation)
(define-instance %mutex-release-thunk operation)

(add-method (initialize (mutex access-cons owner depth name
			       acquire-thunk release-thunk) self)
  (set! access-cons (cons nil nil))	; (held-flag . parked-waiters)
  (set! owner #f)
  (set! depth 0)
  (set! name #f)
  ;; The winding a guarded section pushes (%WITH-GUARD, WITH-MUTEX)
  ;; names these, made once here rather than at every entry.
  (set! acquire-thunk (lambda () (acquire-mutex self)))
  (set! release-thunk (lambda () (release-mutex self)))
  self)

(add-method (%mutex-acquire-thunk (mutex acquire-thunk) self) acquire-thunk)
(add-method (%mutex-release-thunk (mutex release-thunk) self) release-thunk)

(add-method (mutex-name (mutex name) self) name)
(add-method ((setter mutex-name) (mutex name) self new) (set! name new))
(add-method (%mutex-owner (mutex owner) self) owner)

;;; Who holds it: the current process (the fixnum 0 before there is
;;; one), or for a %THREAD-MUTEX the OS thread.

(add-method (%mutex-self (mutex) self) (%load-process))

(define-instance %thread-mutex type '() (list mutex))

(add-method (%mutex-self (%thread-mutex) self) (%thread-index))

(define (%make-named-mutex type name)
  (let ((m (make type)))
    (set! (mutex-name m) name)
    m))

(define (make-named-mutex name) (%make-named-mutex mutex name))

(define mutex-report-spins 1000000)	; wait steps before a report,
(define mutex-report-ms 5000)		; or milliseconds parked

(add-method (acquire-mutex (mutex access-cons owner depth name) self)
  (let ((me (%mutex-self self)))
    (if (eq? owner me)
	(set! depth (+ depth 1))
	(iterate wait ((n 0) (parked 0) (reported #f))
	  (cond ((%test-and-set-locative (make-locative (car access-cons))
					 #f #t)
		 (set! owner me)
		 (set! depth 1))
		(else
		 (let ((report? (and (not reported)
				     (or (>= n mutex-report-spins)
					 (>= parked mutex-report-ms)))))
		   (when report?
		     (format standard-error
			     "~&;; ~S waiting for mutex ~S, held by ~S~%"
			     me (or name self) owner))
		   (wait (+ n 1)
			 (+ parked (%mutex-wait self))
			 (or reported report?)))))))))

(add-method (release-mutex (mutex access-cons owner depth name) self)
  (cond ((not (eq? owner (%mutex-self self)))
	 (error "RELEASE-MUTEX of ~S by ~S, which does not hold it (~S does)."
		(or name self) (%mutex-self self) owner))
	((> depth 1)
	 (set! depth (- depth 1)))
	(else
	 (set! depth 0)
	 (set! owner #f)
	 ;; Free it, then wake the parked: a waiter registers before it
	 ;; looks at the flag, so it either finds the mutex free or is on
	 ;; the list by the time the list is taken (or, the two plain
	 ;; accesses here reordered by the machine, sleeps out its short
	 ;; timeout, which is why the park has one).
	 (set! (car access-cons) nil)
	 (unless (null? (cdr access-cons))
	   (dolist (w (%mutex-take-waiters access-cons))
	     (%thread-unpark w))))))

;;; (WITH-MUTEX m . body): BODY holding M, released however BODY exits:
;;; a WIND-PROTECT whose thunks are the mutex's own (no closures made
;;; at the entry; %WITH-GUARD in unwind-protect.oak is the same).

(define-syntax (with-mutex m . body)
  (let ((v (genvar)))
    `(let ((,v ,m))
       (acquire-mutex ,v)
       (%push-winding (list* (%mutex-release-thunk ,v)
			     (%mutex-acquire-thunk ,v)
			     (get-current-fluid-bindings)))
       (block0 (block ,@body)
	       (%pop-winding)
	       (release-mutex ,v)))))

;;; process2.oak

;; see process.oak for an explaination

(define *pid-counter* 0)

(define (new-pid)
  ;; Lock-free: a new OS thread makes its first process while its
  ;; process register still holds its parent's, so this must not
  ;; depend on who holds a mutex.
  (fetch-and-add (make-locative *pid-counter*) 1))

;;; Atomic operations on a cell (a locative), in terms of
;;; %TEST-AND-SET-LOCATIVE, which compares with EQ?, so these are for
;;; fixnums and objects, not bignums.

;;; The value found: OLD when the swap happened, else what was there.
(define (compare-and-swap loc old new)
  (iterate retry ()
    (let ((cur (contents loc)))
      (cond ((not (eq? cur old)) cur)
	    ((%test-and-set-locative loc old new) old)
	    (else (retry))))))

;;; Adds N to the fixnum in the cell; the value before.
(define (fetch-and-add loc n)
  (iterate retry ()
    (let ((old (contents loc)))
      (if (%test-and-set-locative loc old (+ old n))
	  old
	  (retry)))))

;;; --------------------------------------------------
;;; bootstrap initial process and redefine initialization
;;; redefine the initialization for processes after the first...
;;; redefine fluid operations ater the first...
;;; --------------------------------------------------

(define %threads-initialized #f)

;;; The native compiler's guard (native-compiler.oak keeps its per-file
;;; state in globals); defined here, in system-locale, so that both
;;; sides see it.
(define *native-compiler-mutex* #f)

(define (init-process-object)
  ;;; Give this virtual machine a process object.  Anything that reaches
  ;;; the scheduler -- PROCESS-ID, PAUSE, PROCESS-RUN-FN, FORCE of a
  ;;; future -- needs one, and unlike the mutexes below this is harmless
  ;;; on its own, so it is a warm boot action.
  ;;; The test is on the register rather than on a flag: the process
  ;;; register is not part of a dumped world, so it comes back as the
  ;;; fixnum 0 on every boot while a flag would come back set.
  (when (eq? (%load-process) 0)
    (%store-process (make process))))

(define (init-thread-infrastructure)
  ;;; The process object is per run: the process register is not part
  ;;; of a dumped world.  The rest is in the world once made, and a
  ;;; dumped world keeps it along with %THREADS-INITIALIZED.
  (init-process-object)
  (unless %threads-initialized
    (set! %no-threading #f)
    (set! *symbol-table-mutex* (make-named-mutex 'symbol-table))
    (set! *add-method-mutex* (make-named-mutex 'add-method))
    (set! *expression-table-mutex* (make-named-mutex 'expression-table))
    (set! *stream-primitive-mutex* (make-named-mutex 'stream-primitive))
    (set! *locale-mutex* (make-named-mutex 'locale))
    (set! *fluid-table-mutex* (make-named-mutex 'fluid-table))
    (set! *mix-types-mutex* (make-named-mutex 'mix-types))
    (set! *output-mutex* (make-named-mutex 'output))
    (set! *native-compiler-mutex* (make-named-mutex 'native-compiler))
    (set! *load-mutexes* (make-string-hash-table))
    (set! *load-table-mutex* (make-named-mutex 'load-table))
    (set! *threads* (make-eq-hash-table))
    (set! *threads-mutex* (make-named-mutex 'threads))
    (%thread-register (make thread 'main))
    (set! %threads-initialized #t)))

(define (setup-initial-process-object)
  ;;; --pthreads N: the extra heavyweight threads.  The infrastructure
  ;;; itself is up since warm boot.
  (init-thread-infrastructure)
  (spawn-heavyweight-threads))

;;; Every warm boot makes the process object: without it the process
;;; register holds the fixnum 0 and the scheduler, and so DELAY/FORCE,
;;; cannot run at all.  In an emulator with threads the guard mutexes
;;; come on then too, whether or not --pthreads follows; without
;;; threads they stay #f and the guarded sections cost nothing.  Both
;;; before CMDLINE-EAT, so that an --eval or a --load can already use
;;; the scheduler.

(define (init-threads-at-boot)
  (if (%threads-enabled?)
      (init-thread-infrastructure)
      (init-process-object)))

(add-warm-boot-action-first init-threads-at-boot)


;;--------------------------------------------------

;;; testandset.oak


;;; Test-and-set in terms of mutexes.  When the test (a predicate on
;;; the test-and-settable object) is true, the new value is assigned
;;; and returned, otherwise #f is returned.

;;; This is NOT the same as %test-and-set-car behavior, where the only
;;; predicate is (essentially) null? and the only non-null value is
;;; #t; here the predicate can be any function and the set value can
;;; be any non-nil value (so that success/failure can be distinguished
;;; when the set value is returned).


(define-instance test-and-settable type '(ts-value) (list mutex))
(define-instance test-and-set operation)

; for debugging purposes only...
(define-instance tsval operation)

(add-method (initialize (test-and-settable ts-value) self)
  (set! ts-value '())
  (^super mutex initialize self)
  self)

(add-method (test-and-set (test-and-settable ts-value) self test new-value)
  (let ((set? #t))
    (acquire-mutex self)
    (if (test ts-value) (set! ts-value new-value) (set! set? #f))
    (release-mutex self)
    (if set? new-value #f)))

(add-method (tsval (test-and-settable ts-value) self) ts-value)

;;; schedule.oak


;;; in order to avoid deadlock, the interrupt that invokes context
;;; switching must be disabled during scheduler interaction on a
;;; per-virtual-machine basis (between virtual machines, a mutex is
;;; used to preserve the critical section)

;;; at context switch time, the process register is fixed:
;;;
;;;  * when a process is switched out, lwp gets the current process
;;;    and saves it
;;;
;;;  * when a process is switched in, start gets the saved process and
;;;    sets it
;;;
;;;  * when process-run-fn is called, it creates a new process and
;;;    task and adds the block to the scheduler
;;;
;;; because the scheduler is acquired whenever these things are
;;;   happening, it should not be possible for two different pthreads
;;;   to think they are running the same process at any time (this
;;;   would clearly be bad because then two threads of computation
;;;   could acquire the same mutex at the same time)

(define *scheduleQ* (make-queue))
(define *scheduleQ-mutex* (%make-named-mutex %thread-mutex 'scheduleq))

(define (acquire-scheduler)
  (%disable-alarms)
  (acquire-mutex *scheduleQ-mutex*))
(define (release-scheduler)
  ;; Something to run and a scheduler thread asleep: wake it (after
  ;; the release, so it finds the lock free).
  (let ((wake (and (not (null? *idle-schedulers*))
		   (not (qempty? *scheduleQ*))
		   (let ((w (car *idle-schedulers*)))
		     (set! *idle-schedulers* (cdr *idle-schedulers*))
		     w))))
    (release-mutex *scheduleQ-mutex*)
    (%enable-alarms)
    (when wake (%thread-unpark wake))))

;;; The OS threads parked in BUSY-WORK or START for want of a process
;;; to run, by index; under the scheduler mutex.
(define *idle-schedulers* '())

(define (lwp thunk)
  (acquire-scheduler)
  (enqueue (cons (%load-process) thunk)
	   *scheduleQ*)
  (release-scheduler))

;;; Run the next queued process.  Its callers -- a process made by
;;; PROCESS-RUN-FN at its end, FORCE and a semaphore's WAIT suspending
;;; theirs -- have nothing to return to: the caller's own continuation
;;; is in a queue (a future's waiters, a semaphore's) or done.  So with
;;; nothing queued and another OS thread that may queue something (the
;;; one computing the future, say), wait for it as an idle scheduler,
;;; parked; returning would run on in a dead extent, and the queued
;;; continuation run a second time later.  Alone, there is nothing to
;;; wait for.
;;;
;;; A process that names its OS thread somewhere (by %THREAD-INDEX) for
;;; a waker and then parks keeps alarms off from the one to the other:
;;; the alarm handler is PAUSE, so preempted in between, the process
;;; could go on on another OS thread and park that one, which nothing
;;; would ever unpark.  Here, BUSY-WORK, THREAD-JOIN and CONDITION-WAIT.
(define (start)
  (iterate retry ()
    (acquire-scheduler)
    (cond ((not (qempty? *scheduleQ*))
	   (let ((next (dequeue *scheduleQ*)))
	     (%store-process (car next)) ;; fix process register and proceed
	     (%reset-alarm-counter)
	     (release-scheduler)
	     ((cdr next))))
	  ((> (%thread-count) 1)
	   (let ((me (%thread-index)))
	     (unless (memq me *idle-schedulers*)
	       (set! *idle-schedulers* (cons me *idle-schedulers*)))
	     (release-mutex *scheduleQ-mutex*) ; nothing queued: none to wake
	     (%thread-park %mutex-park-ms)
	     (acquire-mutex *scheduleQ-mutex*)
	     (set! *idle-schedulers* (delq me *idle-schedulers*))
	     (release-scheduler)
	     (retry)))
	  (else
	   (%reset-alarm-counter)
	   (release-scheduler)
	   '()))))


;;; pause causes a context switch. here is an easier-to-read version,
;;; it's expanded in order to make it atomic instead of just depending
;;; on lwp and start being atomic

#|
(define (pause)
  (call/cc
   (lambda (k)
     (lwp (lambda () (k #f)))
     (start))))
|#

(define (pause)
  (if (%process-pinned? (%load-process))
      ;; A thread of the program's own: other processes are not for it
      ;; to run, nor its process for any other thread to resume.
      (block (%reset-alarm-counter)
	     (%thread-yield))
      (%pause-process)))

(define (%pause-process)
  (let ((next nil)
	(pid (process-id (current-process))))
    (acquire-scheduler)
    (when trace-processes
       (format #t "pause: acquired sched~%"))
    (call/cc
     (lambda (k)
       ;; (lwp (lambda () (k #f)))
       (enqueue (cons (%load-process)
		      (lambda () (k #f)))
		*scheduleQ*)
       ;; (start)
       (if (qempty? *scheduleQ*)
	   '()
	   (set! next (dequeue *scheduleQ*)))
       (when next (%store-process (car next))) ;; fix process register and proceed
       (when trace-processes
	  (format #t "pause: pre-reset alarm counter~%"))
       (%reset-alarm-counter)
       (release-scheduler)
       (when next ((cdr next)))))))

;;; no longer calls lwp because this must create a new process object

(define (process-run-fn fn args)
  (acquire-scheduler)
  (enqueue (cons (make process)
		 (lambda ()
		   (apply fn args)
		   (start)))
	   *scheduleQ*)
  (release-scheduler)
  nil)


;;; when heavyweight threads have nothing else to do, they have to be given
;;; a job that keeps them monitoring the scheduler. probably a sleep should
;;; be added to this (as another opcode which makes the VM sleep) to make
;;; busy waiting take less machine time

(define (busy-work)
  ;; A scheduler thread's life: run the queued processes, and park
  ;; while there are none (RELEASE-SCHEDULER wakes it when one comes).
  ;; Alarms stay off until it is parked (see START).
  (iterate loop ()
    (acquire-scheduler)
    (cond ((qempty? *scheduleQ*)
	   (let ((me (%thread-index)))
	     (unless (memq me *idle-schedulers*)
	       (set! *idle-schedulers* (cons me *idle-schedulers*))))
	   (release-mutex *scheduleQ-mutex*) ; nothing queued: none to wake
	   (%thread-park #f)
	   (%enable-alarms))
	  (else
	   (release-scheduler)
	   (pause)))
    (loop)))


;;; What a new heavyweight thread runs: (%make-heavyweight-thread
;;; start-busy-work), from SPAWN-HEAVYWEIGHT-THREADS.  The thread
;;; starts with its parent's process in its process register; it gets
;;; one of its own (with the parent's fluid bindings) before it does
;;; anything that could be taken as the parent's doing, mutexes being
;;; held by processes.

(define (start-busy-work)
  (%store-process (make process))
  (%thread-register (make thread 'scheduler))
  (busy-work))

;;; --------------------------------------------------
;;; One step of waiting for a held mutex (ACQUIRE-MUTEX's slow path);
;;; the value is the milliseconds spent parked.
;;;
;;; The scheduler's lock is held for a few instructions with alarms
;;; off, so for it, and inside the scheduler's section (SIGNAL takes
;;; a semaphore's mutex there), the step is a yield.  Otherwise, with
;;; processes queued, run them (PAUSE): the holder may be among them,
;;; and it is what the alarm would do -- but not on a thread of the
;;; program's own, whose process is pinned to it.  With nothing queued and
;;; another OS thread to release the mutex, park, registered in the
;;; mutex's waiter list, for at most %MUTEX-PARK-MS: RELEASE-MUTEX
;;; unparks the list.  The timeout covers a wakeup lost in the
;;; register/look/park window (the permit model makes an unpark that
;;; comes first count, so the window is only a reordered pair of
;;; plain accesses) and one lost to this process's being preempted and
;;; resumed on another OS thread between registering and parking (the
;;; list names the first), and lets a parked thread notice processes
;;; queued meanwhile.  Alone on the only OS thread with nothing queued, the
;;; holder cannot run at all; the loop spins on to the report.
;;; --------------------------------------------------

(define %mutex-park-ms 10)

(define (%in-scheduler?)
  (eq? (%mutex-owner *scheduleQ-mutex*) (%thread-index)))

;;; The waiter list in the cdr of the access-cons, lock-free with
;;; %TEST-AND-SET-LOCATIVE, which can fail spuriously under threads:
;;; every loop rereads.

(define (%mutex-add-waiter cell me)
  (iterate retry ()
    (let ((old (cdr cell)))
      (unless (%test-and-set-locative (make-locative (cdr cell))
				      old (cons me old))
	(retry)))))

(define (%mutex-drop-waiter cell me)
  (iterate retry ()
    (let ((old (cdr cell)))
      (when (and (memq me old)
		 (not (%test-and-set-locative (make-locative (cdr cell))
					      old (delq me old))))
	(retry)))))

(define (%mutex-take-waiters cell)
  (iterate retry ()
    (let ((old (cdr cell)))
      (cond ((null? old) '())
	    ((%test-and-set-locative (make-locative (cdr cell)) old '()) old)
	    (else (retry))))))

(add-method (%mutex-wait (%thread-mutex) self)
  (%thread-yield)
  0)

(add-method (%mutex-wait (mutex access-cons) self)
  (cond ((%in-scheduler?)
	 (%thread-yield)
	 0)
	((and (not (qempty? *scheduleQ*))
	      (not (%process-pinned? (%load-process))))
	 (pause)
	 0)
	((> (%thread-count) 1)
	 (let ((me (%thread-index)))
	   (%mutex-add-waiter access-cons me)
	   (let ((woken (or (null? (car access-cons)) ; freed meanwhile
			    (%thread-park %mutex-park-ms))))
	     (%mutex-drop-waiter access-cons me)
	     (if woken 0 %mutex-park-ms))))
	(else
	 (%thread-yield)
	 0)))

;;; --------------------------------------------------
;;;  Check to see if the user added a -pthreads option
;;;  and launch some heavyweight threads accordingly.
;;; --------------------------------------------------

(define heavyweight-thread-count 1)

(define (spawn-heavyweight-threads)
  (when (> heavyweight-thread-count 1)
    (format t "Spawning ~s pthreads.~%" heavyweight-thread-count)
    (dotimes (i (- heavyweight-thread-count 1))
       (unless (%make-heavyweight-thread start-busy-work)
	  (format t "Could not start heavyweight thread ~s.~%" (+ i 1))))))

;;; semaphore.oak



;;; semaphores in terms of queues and mutexes.

;;; When processes wait on a semaphore, they are put in the queue as a
;;; pair of a process object and the closure representing it's
;;; continuing computation.  This can then be moved directly to the
;;; scheduler when the semaphore is signaled.


(define-instance semaphore type '(s-value s-Q) (list mutex))

(define-instance wait operation)
(define-instance signal operation)

(add-method (initialize (semaphore s-value s-Q) self)
  (set! s-value 0)
  (set! s-Q (make-queue))
  (^super mutex initialize self)
  self)

(add-method (wait (semaphore s-value s-Q) self)
  (acquire-mutex self)
  (set! s-value (- s-value 1))
  (cond ((not (< s-value 0))
	 (release-mutex self))
	((%process-pinned? (%load-process))
	 ;; A thread of the program's own parks; SIGNAL calls the thunk
	 ;; it queues instead of handing it to the scheduler.
	 (let ((woken (list #f))
	       (me (%thread-index)))
	   (enqueue (cons (current-process)
			  (lambda ()
			    (set! (car woken) #t)
			    (%thread-unpark me)))
		    s-Q)
	   (release-mutex self)
	   (iterate park ()
	     (unless (car woken)
	       (%thread-park %mutex-park-ms)
	       (park)))))
	(else
	 ;; add to s-Q and block until woken
	 (call/cc (lambda (c)
		    ;; since context switching preserves current-process,
		    ;; we should be able to just grab and go
		    (enqueue (cons (current-process)
				   (lambda () (c nil)))
			     s-Q)
		    (release-mutex self)
		    (start)))))
  nil)

;;; WARNING: make sure that no other virtual process acquires a
;;; semaphore without first acquiring the scheduler! disabling alarms
;;; only prevents interrupts from occuring within the current pthread!
;;; (this should not be a problem since only these routines should
;;; acquire the semaphore)

(add-method (signal (semaphore s-value s-Q) self)
  (acquire-scheduler)
  (acquire-mutex self)

  (set! s-value (+ s-value 1))
  (when (<= s-value 0) ;; wake up the next blocked process
    (let ((w (dequeue s-Q)))
      (if (%process-pinned? (car w))
	  ((cdr w))
	  (enqueue w *scheduleQ*))))

  (release-mutex self)
  (release-scheduler)
  nil)

;;; future.oak


;;; futures: promises in a multitasking world


(define-instance future-obj type
  '(flag val scheduled? dependantsQ sched-policy err-policy)
  (list forcible mutex))

(add-method (initialize (future-obj flag val scheduled? dependantsQ sched-policy err-policy) self oper)
  (set! scheduled? (make test-and-settable))
  (set! dependantsQ (make-queue))
  (set! sched-policy 'unused)
  (set! err-policy 'unused)
  (set! flag #f)
  (set! val oper)
  ;;(^super forcible initialize self)
  (^super mutex initialize self)
  self)

;;; The computation, by whoever claimed it (SCHEDULED?): the value
;;; stored, and the processes waiting for it handed to the scheduler.
(define-instance %future-compute operation)
(add-method (%future-compute (future-obj flag val dependantsQ) self)
  (let ((newval (val)))
    (acquire-mutex self)
    (set! flag #t)
    (set! val newval)
    (release-mutex self)
    ;; at this point no more people will
    ;; be trying to add themselves...
    (acquire-scheduler)
    (qappend *scheduleQ* dependantsQ)
    (release-scheduler)))

(define-instance %force-process operation)

(add-method (force (future-obj flag val scheduled?) self)
  (if (%process-pinned? (%load-process))
      ;; A thread of the program's own computes the value itself when no
      ;; one has begun to, else waits for it parked: it may not suspend
      ;; its process into the queues below, from which another OS thread
      ;; would resume it.
      (block
	(when (test-and-set scheduled? null? #t)
	  (%future-compute self))
	(iterate wait ()
	  (acquire-mutex self)
	  (let ((done flag))
	    (release-mutex self)
	    (cond (done val)
		  (else (%thread-park 1)
			(wait))))))
      (%force-process self)))

(add-method (%force-process (future-obj flag val scheduled? dependantsQ) self)
  ;; Run whatever the scheduler still holds before suspending.  A
  ;; waiter left in the queue and resumed later runs the next fresh
  ;; thunk on its own dead stack extent, where this caller's catch
  ;; frames do not exist, and a throw out of the forced body then
  ;; unwinds into garbage.  The preemptive alarm usually drains the
  ;; queue first, which is why this almost never showed; draining here
  ;; makes it certain, preemption or not.
  (iterate drain ((i 0))
    (unless (or (qempty? *scheduleQ*) (= i 100))
      (pause)
      (drain (+ i 1))))
  (acquire-mutex self) ; this mutex prevents dependants from enqueueing badly
  (if flag
      (block (release-mutex self)
	     val)
      (call/cc (lambda (c)
		 ;; suspend the current task into the destination queue
		 (enqueue (cons (current-process);; process calling force
				(lambda ()
				  (let ((result (force self)))
				    (c result))))
			  dependantsQ)
		 (release-mutex self) ; now that we're enqueued, we're safe
		 ;; someone claim responsibility for and initiate future computation
		 (let ((schedule? (test-and-set scheduled? null? #t)))
		   (when schedule?
			 (process-run-fn (lambda () (%future-compute self))
					 nil)))
		 (start)))))

(define-syntax delay
  (lambda (form)
    `(make future-obj (lambda () . ,(cdr form)))))

(define-syntax future
  (lambda (form)
    `(let ((foosym (make future-obj (lambda () . ,(cdr form)))))
       (process-run-fn force (list foosym))
       foosym)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; OS threads for programs: MAKE-THREAD, THREAD-JOIN, condition
;;; variables.  Each such thread runs one process (with a copy of its
;;; creator's fluid bindings and its creator's winding stack) on an OS
;;; thread of its own, from the thunk to its end; THREAD-JOIN waits
;;; for it and gives its value, or signals its error again.  Waiting
;;; parks the OS thread (the emulator's park/unpark, stream primitives
;;; 19 and 20): no spinning, but no other process runs on that thread
;;; meanwhile either, so these are for programs that want OS threads,
;;; not a replacement for FUTURE and the lightweight processes.

(define (%thread-park ms) ((%stream-primitive 19) ms))	; #f: until unparked
(define (%thread-unpark index) ((%stream-primitive 20) index))
(define (thread-sleep ms) ((%stream-primitive 21) ms))
(define (thread-count) (%thread-count))

(define-instance thread type
  '(name state value index process lock waiters) (list object))

(define-instance thread-name operation)
(define-instance thread-alive? operation)
(define-instance thread-join operation)
(define-instance %thread-register operation)
(define-instance %thread-run operation)

;;; The thread objects by OS thread index, the main thread's first.
(define *threads* #f)
(define *threads-mutex* #f)
(define *thread-counter* 0)

(add-method (initialize (thread name state value index process lock waiters)
		    self the-name)
  (set! name the-name)
  (set! state 'new)			; then RUNNING, and DONE or FAILED
  (set! value #f)			; the thunk's value, or its condition
  (set! index #f)
  (set! process #f)
  (set! lock (make-named-mutex the-name))
  (set! waiters '())			; OS threads parked in THREAD-JOIN
  self)

(add-method (thread-name (thread name) self) name)

(add-method (thread-alive? (thread state) self)
  (or (eq? state 'new) (eq? state 'running)))

(add-method (print (thread name state) self stream)
  (format stream "#<Thread ~A ~A>" name state))

;;; On the thread itself: it is the current thread from here on.
(add-method (%thread-register (thread state index process) self)
  (set! index (%thread-index))
  (set! process (current-process))
  (set! state 'running)
  (%guard *threads-mutex*
	  (lambda () (set! (present? *threads* index) self))))

(define (current-thread)
  (and *threads*
       (%guard *threads-mutex*
	       (lambda ()
		 (let ((entry (present? *threads* (%thread-index))))
		   (and entry (cdr entry)))))))

(define (%condition-string c)
  (let ((s (make string-output-stream)))
    (report c s)
    (#^string s)))

;;; What the new OS thread runs.
(add-method (%thread-run (thread name state value index lock waiters)
		    self thunk)
  (%store-process (make pinned-process))
  (%thread-register self)
  (let ((outcome (catch-errors (general-error (lambda (e) (cons 'failed e)))
		   (cons 'done (thunk)))))
    (let ((ws (%guard lock
		      (lambda ()
			(set! value (cdr outcome))
			(set! state (car outcome))
			(let ((w waiters))
			  (set! waiters '())
			  w)))))
      (dolist (w ws) (%thread-unpark w)))
    (%guard *threads-mutex*
	    (lambda () (set! (present? *threads* index) nil)))))

(define (make-thread thunk . name)
  (let ((t (make thread
		 (if (null? name)
		     (format #f "thread-~D"
			     (fetch-and-add (make-locative *thread-counter*) 1))
		     (car name)))))
    (unless (and *threads*
		 (%make-heavyweight-thread (lambda () (%thread-run t thunk))))
      (error "MAKE-THREAD: no OS thread could be started (an emulator without threads?)~%"))
    t))

;;; The thread's value, waiting for it; with a timeout in milliseconds,
;;; #f if it is still running when that runs out.  A thread that
;;; failed makes its error the joiner's.
(add-method (thread-join (thread name state value lock waiters) self . timeout)
  (let ((ms (if (null? timeout) #f (car timeout))))
    (iterate wait ()
      ;; #t once it has finished, else the OS thread this process
      ;; parks, alarms off until it is parked (see START).
      (let ((me (%guard lock
			(lambda ()
			  (or (eq? state 'done) (eq? state 'failed)
			      (block (%disable-alarms)
				     (let ((me (%thread-index)))
				       (set! waiters (cons me waiters))
				       me)))))))
	(cond ((eq? me #t)
	       (if (eq? state 'failed)
		   (error "Thread ~A died: ~A~%" name (%condition-string value))
		   value))
	      ((let ((woken (%thread-park ms)))
		 (%enable-alarms)
		 woken)
	       (wait))
	      (else
	       (%guard lock (lambda () (set! waiters (delq me waiters))))
	       (if (or (eq? state 'done) (eq? state 'failed)) (wait) #f)))))))

;;; Condition variables, for use with a mutex: CONDITION-WAIT gives
;;; the mutex up, parks until notified (or for a timeout, in
;;; milliseconds), and takes the mutex again before returning #t
;;; (#f after a timeout).  Spurious wake-ups are possible: wait in a
;;; loop that tests the condition.

(define-instance condition-variable type '(waiters lock) (list object))
(define-instance condition-wait operation)
(define-instance condition-notify operation)
(define-instance condition-notify-all operation)

(add-method (initialize (condition-variable waiters lock) self)
  (set! waiters '())
  (set! lock (make-named-mutex 'condition-variable))
  self)

;;; A waiter is a ticket, (OS thread index . notified?), which a notify
;;; takes off the list and marks before it unparks the thread.  Woken
;;; unmarked (by an unpark meant for an earlier park of the thread), a
;;; waiter parks again, or with a timeout takes its ticket off itself
;;; and returns #f: no notify is ever spent on a waiter that has gone.

(add-method (condition-wait (condition-variable waiters lock) self m . timeout)
  (let* ((ms (if (null? timeout) #f (car timeout)))
	 (ticket (%guard lock
			 (lambda ()
			   (%disable-alarms)	; until parked (see START)
			   (let ((tk (cons (%thread-index) #f)))
			     (set! waiters (append! waiters (list tk)))
			     tk)))))
    (release-mutex m)
    (iterate park ()
      (when (and (%thread-park ms) (not ms) (not (cdr ticket)))
	(park)))
    (%enable-alarms)
    (let ((notified (%guard lock
			    (lambda ()
			      (or (cdr ticket)
				  (block (set! waiters (delq ticket waiters))
					 #f))))))
      (acquire-mutex m)
      notified)))

(add-method (condition-notify (condition-variable waiters lock) self)
  (let ((w (%guard lock
		   (lambda ()
		     (and (not (null? waiters))
			  (let ((tk (car waiters)))
			    (set! waiters (cdr waiters))
			    (set! (cdr tk) #t)
			    tk))))))
    (when w (%thread-unpark (car w)))
    (not (not w))))

(add-method (condition-notify-all (condition-variable waiters lock) self)
  (let ((ws (%guard lock
		    (lambda ()
		      (let ((w waiters))
			(set! waiters '())
			(dolist (tk w) (set! (cdr tk) #t))
			w)))))
    (dolist (tk ws) (%thread-unpark (car tk)))
    (length ws)))
