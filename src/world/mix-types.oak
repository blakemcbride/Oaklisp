;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Define mixin management tools.
;;

(define-instance mixin-manager type '(type-alist) (list object))

(add-method (initialize (mixin-manager type-alist) self)
  (set! type-alist '())
  self)

(define-instance mix-types operation)

;;; The alist is shared by every thread.  Its walk and the insert run
;;; under *MIX-TYPES-MUTEX* (made by the thread infrastructure; taken
;;; directly, this being before %GUARD exists, which is fine: the
;;; sections are a walk and a cons and cannot throw); the type itself
;;; is made outside, and installed unless another thread has got there
;;; meanwhile.

(define *mix-types-mutex* #f)

(add-method (mix-types (mixin-manager type-alist) self types)
  (labels
      ((lookup
	(lambda ()
	  ;; The type made of exactly TYPES, or nil.  (EQUAL? does not
	  ;; exist yet, so the lists are compared element by element.)
	  (iterate aux ((l type-alist))
	    (if (null? l)
		nil
		(iterate loop ((x types) (y (caar l)))
		  (cond ((null? x)
			 (if (null? y) (cdar l) (aux (cdr l))))
			((or (null? y) (not (eq? (car x) (car y))))
			 (aux (cdr l)))
			(else (loop (cdr x) (cdr y)))))))))
       (locked
	(lambda (thunk)
	  (if *mix-types-mutex* (acquire-mutex *mix-types-mutex*))
	  (let ((result (thunk)))
	    (if *mix-types-mutex* (release-mutex *mix-types-mutex*))
	    result))))
    (or (locked lookup)
	(let ((newtype (make type '() types)))
	  (locked (lambda ()
		    (or (lookup)
			(block
			  (set! type-alist (cons (cons types newtype) type-alist))
			  newtype))))))))

;;; eof
