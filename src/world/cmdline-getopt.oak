;;; A switch can be abbreviated to a unique prefix of its name, as the
;;; emulator's can.

(define (getopt options args)
  (let aux ((args args))
    (if (null? args)
	'()
	(cond ((strip-dashes (car args))
	       => (lambda (a)
		    (let ((matches (options-matching a options)))
		      (cond ((and (pair? matches) (null? (cdr matches)))
			     (let* ((o (car matches))
				    (a (car o)))
				(let ((n (cadr o))
				      (f (caddr o)))
				  (when (< (length (cdr args)) n)
				    (format standard-error
					    "~&error: switch ~A needs ~D argument~P"
					    a n n)
				    (exit 1))
				  (let ((stuff (head (cdr args) n)))
				    (catch-errors (general-error
						   (lambda (err)
						     ;; Remember that this
						     ;; run did not do what
						     ;; it was asked, so it
						     ;; does not exit 0 and
						     ;; leave a make rule
						     ;; linking whatever
						     ;; stale object the
						     ;; failed --compile
						     ;; left behind.
						     (set! command-line-failures
							   (+ command-line-failures 1))
						     (format standard-error
							     "~&An error occurred while processing switch ~A args ~S~%"
							     a stuff)
						     ;; Reporting the error can
						     ;; itself signal, since it
						     ;; prints the offending
						     ;; object and that object
						     ;; may be the half
						     ;; initialized thing whose
						     ;; INITIALIZE just failed.
						     ;; Contain that here: a
						     ;; switch that cannot even
						     ;; be described must not
						     ;; stop the switches after
						     ;; it from being processed.
						     (catch-errors
						      (general-error
						       (lambda (err2)
							 (format standard-error
								 "~&(this error could not be reported)~%")))
						      (report err standard-error)
						      (format standard-error "~%"))))
						  (apply f stuff)))
				  (aux (tail (cdr args) n)))))
			    (else (format standard-error
					  (if (null? matches)
					      "~&error: unknown switch: ~A"
					      "~&error: ambiguous switch: ~A")
					  a)
				  (exit 1))))))
	      (else args)))))

;;; The option named A, or else every option whose name starts with A.

(define (options-matching a options)
  (cond ((ass equal? a options) => list)
	(else
	 (let ((n (length a)))
	   (let next ((options options) (matches '()))
	     (cond ((null? options) (reverse matches))
		   ((let ((name (car (car options))))
		      (and (<= n (length name))
			   (equal? a (subseq name 0 n))))
		    (next (cdr options) (cons (car options) matches)))
		   (else (next (cdr options) matches))))))))

(define (strip-dashes a)
  (let ((n (length a)))
    (and (> n 1)
	 (equal? (nth a 0) #\-)
	 (let ((dashlen (if (equal? (nth a 1) #\-) 2 1)))
	   (and (> n dashlen)
		(subseq a dashlen (- n dashlen)))))))
