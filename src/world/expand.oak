;;; The quick and dirty macro expander written in T ported back to Oaklisp.

(define-instance expand-groveling operation)
(define-instance idiosyncratically-grovel operation)

(define (improper-list? x)
  (if (pair? x)
      (cdr (last-pair x))
      x))

(define (make-proper x)
  (if (pair? x)
      (let ((the-copy (copy x)))
	(set! (cdr (last-pair the-copy)) nil)
	the-copy)
      '()))

(define (safe-length self)
  (if (pair? self)
      (+ 1 (safe-length (cdr self)))
      0))


(define (map-proper-part op l)
  (let ((improper-part (improper-list? l)))
    (if improper-part
	(let ((proper-answer (map op (make-proper l))))
	  (set! (cdr (last-pair proper-answer)) improper-part)
	  proper-answer)
	(map op l))))


(define (special-form? sym)
  (or (eq? sym 'quote)
      (eq? sym '%block)
      (eq? sym '%if)
      (eq? sym '%add-method)
      (eq? sym '_%add-method)
      (eq? sym '%make-locative)
      (eq? sym '%labels)))
; eventually (%unwind-protect unwind-protect0 catch %fluid-bind)

(define trace-expansion nil)

(add-method (expand-groveling (locale) self form)
  (if trace-expansion (format #t "~&expand-groveling ~S~%" form))
  (cond ((is-a? form self-evaluatory-mixin)
	 form)
	((not (pair? form))
	 (if (special-form? form)
	     (warning "Special form specifier ~A used as a variable.~%" form))
	 form)
	((special-form? (car form))
	 (idiosyncratically-grovel self form))
	(else (let ((m (macro? self (car form))))
		(cond (m (expand-groveling self (m form)))
		      (else (map-proper-part (lambda (x) (expand-groveling self x)) form)))))))

(add-method (idiosyncratically-grovel (locale) self form)
  (if trace-expansion (format #t "~&idiosyncratically-grovel ~s~%" form))
  (let ((s (car form)))
    (cond ((or (eq? s '%if)
	       (eq? s '%block)
	       (eq? s '%make-locative))
	   `(,(first form)
	     . ,(map (lambda (x) (expand-groveling self x))
		     (cdr form))))
	  ((or (eq? s '%add-method)
	       (eq? s '_%add-method))
	   (destructure* (kind (op (typ . ivars) . args) body) form
	     (let ((rest (improper-list? args))
		   (body (expand-groveling self body)))
	       `(,kind
		 (,(expand-groveling self op)
		  (,(expand-groveling self typ) . ,ivars) . ,args)
		 ,(if (and rest
			   (eq? kind '%add-method)
			   (not (raw-rest-name? rest))
			   (rest-needs-list? body rest (lambda-op? op)))
		      (listify-rest-body self rest body)
		      body)))))
	  ((eq? s '%labels)
	   `(,(first form)
	     ,(map (lambda (x)
		     (destructure (var val) x
		       `(,var ,(expand-groveling self val))))
		   (second form))
	     ,(expand-groveling self (third form))))
	  ((eq? s 'quote)
	   form)
	  (else (error "Form ~S can't be idiosyncratically groveled." form)))))


;;; Rest arguments as lists.  A rest argument lives on the stack, and a
;;; method may only pass it on in a tail call, (f a . rest), or measure
;;; it with (rest-length rest).  When the expanded body of a method uses
;;; its rest name any other way -- as an ordinary variable, in a call
;;; that is not a tail call, from inside an inner lambda -- the body is
;;; rewritten to receive the extra arguments as a list:
;;;
;;;   (listify-args (lambda (rest) BODY') . rest)
;;;
;;; where BODY' has (f a . rest) turned into (apply f a rest) and
;;; (rest-length rest) into (length rest).  Methods that use the rest
;;; name only the documented ways are left exactly as they were, and so
;;; are methods whose rest name starts with %, for code that plays
;;; tricks with the stack (dump-stack).

(define (raw-rest-name? rest)
  (eq? #\% (nth (#^string rest) 0)))

(define (rest-shadowed? rest ivars args)
  (or (memq rest ivars)
      (memq rest (make-proper args))
      (eq? rest (improper-list? args))))

;;; The documented ways, as the compiler supports them: (f a . rest) as
;;; a tail call of the method itself, and (rest-length rest) anywhere
;;; in the method itself.  The body of an immediately applied lambda
;;; (what LET becomes) or of a LABELS binding (what ITERATE becomes) is
;;; compiled inline, so it counts as the method itself; any other inner
;;; lambda does not.  TOP? says we are in the method itself, TAIL? in
;;; tail position.
;;;
;;; A LAMBDA (or DEFINE) with a way out that leaves its rest args on
;;; the stack gets the list too (REST-EXITS-OK? below);
;;; (lambda (a . r) (rest-length r)) answers the right number that way.
;;; Only a LAMBDA: low level methods written with ADD-METHOD (^SUPER's,
;;; the cold ERROR, %PUSH) leave theirs on purpose, and keep the
;;; compiler's warning.

;;; The operation of a method LAMBDA made: ('make 'operation).
(define (lambda-op? op)
  (and (pair? op)
       (pair? (cdr op))
       (null? (cddr op))
       (pair? (car op)) (eq? (car (car op)) 'quote)
       (pair? (cadr op)) (eq? (car (cadr op)) 'quote)))

(define (rest-needs-list? body rest anonymous?)
  (labels (((walk form top? tail?)
		(cond ((eq? form rest) #t)
		      ((not (pair? form)) #f)
		      (else
		       (let ((s (car form)))
			 (cond ((eq? s 'quote) #f)
			       ((or (eq? s '%add-method)
				    (eq? s '_%add-method))
				(walk-method form top? #f #f))
			       ((eq? s '%labels)
				(and (not (any? (lambda (b) (eq? (car b) rest))
						(second form)))
				     (or (any? (lambda (b)
						 (let ((val (second b)))
						   (if (and (pair? val)
							    (eq? (car val) '%add-method))
						       (walk-method val top? top? #t)
						       (walk val top? #f))))
					       (second form))
					 (walk (third form) top? tail?))))
			       ((eq? s '%if)
				(or (walk (second form) top? #f)
				    (any? (lambda (x) (walk x top? tail?))
					  (cddr form))))
			       ((eq? s '%block)
				(iterate next ((l (cdr form)))
				  (cond ((null? l) #f)
					((null? (cdr l)) (walk (car l) top? tail?))
					((walk (car l) top? #f) #t)
					(else (next (cdr l))))))
			       ((and (eq? s 'rest-length)
				     (pair? (cdr form))
				     (eq? (second form) rest))
				(not top?))
			       (else
				(or (any? (lambda (x) (walk x top? #f))
					  (make-proper (cdr form)))
				    (if (and (pair? s)
					     (eq? (car s) '%add-method))
					(walk-method s top? top? tail?)
					(walk s top? #f))
				    (and (eq? (improper-list? form) rest)
					 (not (and top? tail?))))))))))
	       ;; A method form: its body is the method itself only when
	       ;; INLINE? (an immediately applied lambda).
	       ((walk-method form top? inline? tail?)
		(destructure* (kind (op (typ . ivars) . args) bod) form
		  (or (walk op top? #f)
		      (walk typ top? #f)
		      (and (not (rest-shadowed? rest ivars args))
			   (walk bod inline? (and inline? tail?)))))))
      (or (walk body #t #t)
	  (and anonymous?
	       (not (rest-exits-ok? body rest))))))

;;; Every way out of the method itself has to leave the extra arguments
;;; off the stack: by passing them on in a tail call, or because the
;;; tests on the way there have shown there are none, as in
;;;
;;;   (cond ((zero? (rest-length rest)) 'none)
;;;         (else (f a . rest)))
;;;
;;; or after ((> (rest-length rest) 1) ...) and ((= (rest-length rest)
;;; 1) ...) have both failed.  A LAMBDA that passes them on along some
;;; paths but returns over them along others gets the list too.  Tail
;;; calls to LABELS functions (ITERATE loops) count as their bodies'
;;; exits, and a tail call to ERROR as no exit at all.  Anything not
;;; understood counts as an exit that leaves them, which costs only the
;;; list.  ADD-METHOD written out by hand is not checked: low level
;;; methods such as + return an extra argument with (%RETURN).

;;; What is known about the count of extra arguments: (LO HI EXCLUDED),
;;; HI #f when unbounded.

(define rest-count-unknown '(0 #f ()))

;;; True when the count can only be zero, or when no count is possible
;;; at all (the code is unreachable).
(define (rest-count-zero? known)
  (destructure (lo hi excluded) known
    (and hi
	 (or (< hi lo)
	     (and (< (- hi lo) 64)
		  (iterate next ((n (max lo 1)))
		    (or (> n hi)
			(and (memq n excluded) (next (+ n 1))))))))))

;;; KNOWN after the test (REST-LENGTH REST) OP K: (IF-TRUE . IF-FALSE).
(define (rest-count-compare op k known)
  (destructure (lo hi excluded) known
    (labels (((at-least n) (list (max lo n) hi excluded))
	     ((at-most n) (list lo (if hi (min hi n) n) excluded)))
      (cond ((memq op '(= eq?))
	     (cons (list (max lo k) (if hi (min hi k) k) excluded)
		   (list lo hi (cons k excluded))))
	    ((eq? op '>) (cons (at-least (+ k 1)) (at-most k)))
	    ((eq? op '<) (cons (at-most (- k 1)) (at-least k)))
	    ((eq? op '>=) (cons (at-least k) (at-most (- k 1))))
	    (else (cons (at-most k) (at-least (+ k 1))))))))

;;; KNOWN after TEST: (IF-TRUE . IF-FALSE), or #f when TEST says
;;; nothing about the count.  ELSE is what a COND's last clause tests.
(define (rest-count-test test rest known)
  (labels (((count? x)
	    (and (pair? x) (eq? (car x) 'rest-length)
		 (pair? (cdr x)) (eq? (second x) rest) (null? (cddr x))))
	   ((args? n)
	    (and (pair? (cdr test))
		 (if (= n 1)
		     (null? (cddr test))
		     (and (pair? (cddr test)) (null? (cdddr test)))))))
    (cond ((or (eq? test 'else) (eq? test #t))
	   (cons known '(1 0 ())))
	  ((not (pair? test)) #f)
	  ((and (eq? (car test) 'not) (args? 1))
	   (let ((r (rest-count-test (second test) rest known)))
	     (and r (cons (cdr r) (car r)))))
	  ((and (eq? (car test) 'zero?) (args? 1) (count? (second test)))
	   (rest-count-compare '= 0 known))
	  ((and (memq (car test) '(= eq? < > <= >=)) (args? 2))
	   (let ((a (second test))
		 (b (third test)))
	     (cond ((and (count? a) (integer? b))
		    (rest-count-compare (car test) b known))
		   ((and (integer? a) (count? b))
		    (rest-count-compare (cdr (assq (car test)
						   '((= . =) (eq? . eq?)
						     (< . >) (> . <)
						     (<= . >=) (>= . <=))))
					a known))
		   (else #f))))
	  (else #f))))

(define (rest-exits-ok? body rest)
  (labels (((ok? form loops known)
	    (cond ((rest-count-zero? known) #t)
		  ((not (pair? form)) #f)
		  ((eq? (improper-list? form) rest) #t)
		  (else
		   (let ((s (car form)))
		     (cond ((eq? s 'quote) #f)
			   ((eq? s '%if)
			    (let* ((r (rest-count-test (second form) rest known))
				   (if-true (if r (car r) known))
				   (if-false (if r (cdr r) known)))
			      (and (ok? (third form) loops if-true)
				   (if (pair? (cdddr form))
				       (ok? (fourth form) loops if-false)
				       (rest-count-zero? if-false)))))
			   ((eq? s '%block)
			    (and (pair? (cdr form)) (ok? (last form) loops known)))
			   ((eq? s '%labels)
			    (let ((loops (append (map car (second form)) loops)))
			      (and (not (memq rest loops))
				   (every? (lambda (b)
					     (let ((val (second b)))
					       (or (not (pair? val))
						   (not (eq? (car val) '%add-method))
						   (method-ok? val loops known))))
					   (second form))
				   (ok? (third form) loops known))))
			   ((and (pair? s) (eq? (car s) '%add-method))
			    (method-ok? s loops known))
			   ((eq? s 'error) #t)
			   (else (and (symbol? s) (memq s loops) #t)))))))
	   ((method-ok? form loops known)
	    (destructure* (kind (op (typ . ivars) . args) bod) form
	      (and (not (rest-shadowed? rest ivars args))
		   (ok? bod loops known)))))
    (ok? body '() rest-count-unknown)))

(define (rewrite-rest-uses form rest)
  (labels (((rewrite form)
	    (if (not (pair? form))
		form
		(let ((s (car form)))
		  (cond ((eq? s 'quote) form)
			((or (eq? s '%add-method)
			     (eq? s '_%add-method))
			 (destructure* (kind (op (typ . ivars) . args) bod) form
			   `(,kind
			     (,(rewrite op) (,(rewrite typ) . ,ivars) . ,args)
			     ,(if (rest-shadowed? rest ivars args)
				  bod
				  (rewrite bod)))))
			((eq? s '%labels)
			 (if (any? (lambda (b) (eq? (car b) rest)) (second form))
			     form
			     `(,s ,(map (lambda (b) (list (car b) (rewrite (second b))))
					(second form))
				  ,(rewrite (third form)))))
			((and (eq? s 'rest-length)
			      (pair? (cdr form))
			      (eq? (second form) rest))
			 `(length ,rest))
			((eq? (improper-list? form) rest)
			 `(apply ,@(map rewrite (make-proper form)) ,rest))
			(else (map-proper-part rewrite form)))))))
    (rewrite form)))

(define (replace-eq new old tree)
  (cond ((eq? tree old) new)
	((pair? tree)
	 (cons (replace-eq new old (car tree))
	       (replace-eq new old (cdr tree))))
	(else tree)))

(define (listify-rest-body locale rest body)
  (let ((placeholder (genvar)))
    (replace-eq (rewrite-rest-uses body rest)
		placeholder
		(expand-groveling locale
				  `(listify-args (lambda (,rest) ,placeholder)
						 . ,rest)))))





