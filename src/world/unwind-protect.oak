;;; The global %WINDINGS holds a list of items of the form
;;; (UNWIND-LANBDA WIND-LAMBDA . FLUID-BINDING-LIST), and the global
;;; %WIND-COUNT holds the length of %WINDINGS.  Continuations store
;;; the values of these two variables for use when they're continued,
;;; and catch tags hold just the value of %WIND-COUNT which suffices.

;;; When continuing a continuation, the caller unwinds to the join
;;; point and then the callee winds back up to the destination point.


;;; Set up the necessary globals used for holding the winding stack.

(define (unset-windings)
  (set! %windings '())
  (set! %wind-count 0)
  (set! %%pending-rewind #f)
  (set-current-windings! '() 0)
  (set-current-pending-rewind! #f))

;;; The winding stack belongs to the current process, as fluid
;;; bindings do (fluid.oak): resuming one process's continuation must
;;; not unwind another's windings.  Until there is a process object
;;; it is kept in the globals above.  So is the rewind a continuation
;;; leaves for its landing (%CALL/CC, CALL/CC).

(define (current-windings)
  (let ((z (%load-process)))
    (if (eq? z 0) %windings (process-windings z))))

(define (current-wind-count)
  (let ((z (%load-process)))
    (if (eq? z 0) %wind-count (process-wind-count z))))

(define (set-current-windings! windings count)
  (let ((z (%load-process)))
    (cond ((eq? z 0)
	   (set! %windings windings)
	   (set! %wind-count count))
	  (else
	   (set! (process-windings z) windings)
	   (set! (process-wind-count z) count)))))

;;; Pushing and popping are what every guarded section and
;;; WIND-PROTECT does, so with a process they go through one method of
;;; its own (multiproc.oak) rather than four accessors.

(define (%push-winding item)
  (let ((z (%load-process)))
    (cond ((eq? z 0)
	   (set! %windings (cons item %windings))
	   (set! %wind-count (+ %wind-count 1)))
	  (else
	   (%process-push-winding z item)))))

(define (%pop-winding)
  (let ((z (%load-process)))
    (cond ((eq? z 0)
	   (set! %windings (cdr %windings))
	   (set! %wind-count (- %wind-count 1)))
	  (else
	   (%process-pop-winding z)))))

(define (current-pending-rewind)
  (let ((z (%load-process)))
    (if (eq? z 0) %%pending-rewind (process-pending-rewind z))))

(define (set-current-pending-rewind! x)
  (let ((z (%load-process)))
    (if (eq? z 0)
	(set! %%pending-rewind x)
	(set! (process-pending-rewind z) x))))

(unset-windings)

(add-warm-boot-action unset-windings)



;;; This routine returns the height of the join point.

(define (find-join-point windings0 count0 windings1 count1)

  (labels ((aux (lambda (windings0 windings1 count)
		  (cond ((eq? windings0 windings1)
			 count)
			(else
			 (aux (cdr windings0) (cdr windings1) (- count 1)))))))

    (cond ((= count0 count1)
	   (aux windings0 windings1 count0))
	  ((< count0 count1)
	   (aux windings0 (tail windings1 (- count1 count0)) count0))
	  (else
	   (aux (tail windings0 (- count0 count1)) windings1 count1)))))

;;; Usage: (rewind join-point new-%windings new-%wind-count)

(labels ((rewind-aux
	  (lambda (from-count to to-count)
	    (unless (= from-count to-count)
	      (rewind-aux from-count (cdr to) (- to-count 1))
	      (set-current-windings! to to-count)
	      (let ((item (car to)))
;		(set! fluid-binding-list (cddr item))
		(set-current-fluid-bindings (cddr item))
		((cadr item)))))))

  (define (rewind from-count to to-count)
    (unless (= from-count to-count)
      (rewind-aux from-count to to-count)
      (set-current-windings! to to-count))))

;;; Usage as above.

(define (unwind from from-count to-count)
  (iterate aux ((w from)(c from-count))
    (set-current-windings! w c)
    (unless (= c to-count)
      (let ((item (car w)))
;	(set! fluid-binding-list (cddr item))
	(set-current-fluid-bindings (cddr item))
	((car item)))
      (aux (cdr w)(- c 1)))))

;;; The standard interface to this facility:

(define (dynamic-wind before during after)
  (before)
  (%push-winding (list* after before (get-current-fluid-bindings)))
  (block0 (during)
	  (%pop-winding)
	  (after)))

;;; And now some fancy interfaces:

;;; This one keeps you from having to do lambda wrapping:

(define-syntax (wind-protect before during after)
  ;; `(dynamic-wind (lambda () ,before) (lambda () ,during) (lambda () ,after))
  (let ((a (genvar))(b (genvar)))
    `(let ((,b (lambda () ,before)) (,a (lambda () ,after)))
       (,b)
       (%push-winding (list* ,a ,b (get-current-fluid-bindings)))
       (block0 ,during
	       (%pop-winding)
	       (,a)))))

;;; The runtime's guarded sections (%GUARD, multi-off.oak): the mutex
;;; is released however THUNK exits, and taken again should a
;;; continuation re-enter.

(define (%with-guard m thunk)
  (acquire-mutex m)
  (%push-winding (list* (%mutex-release-thunk m) (%mutex-acquire-thunk m)
			(get-current-fluid-bindings)))
  (block0 (thunk)
	  (%pop-winding)
	  (release-mutex m)))

;;; This one does different things depending on whether the entries
;;; and exists are normal or abnormal.

(define-syntax (funny-wind-protect normal-before abnormal-before
				   during
				   normal-after abnormal-after)
  `(block
     ,normal-before
     (%push-winding (list* (lambda () ,abnormal-after)
			   (lambda () ,abnormal-before)
			   (get-current-fluid-bindings)))
     (block0 ,during
	     (%pop-winding)
	     ,normal-after)))

