;;; (STRING->NUMBER STRING [RADIX]): the number STRING spells in RADIX
;;; (default 10), or #f if it spells none.  Accepted: the #b #o #d #x
;;; radix prefixes, the #e #i exactness prefixes (every number here is
;;; exact, so they change nothing), a sign, and an integer or a ratio.

(define (%string->number str radix)
  (let ((end (length str)))
    (labels
	(((digit c radix)
	  (let* ((n (#^number c))
		 (v (cond ((and (>= n 48) (<= n 57)) (- n 48))	;0-9
			  ((and (>= n 97) (<= n 122)) (- n 87))	;a-z
			  ((and (>= n 65) (<= n 90)) (- n 55))	;A-Z
			  (else #f))))
	    (and v (< v radix) v)))

	 ((digits i j radix)
	  (and (< i j)
	       (iterate aux ((i i) (acc 0))
		 (if (= i j)
		     acc
		     (let ((d (digit (nth str i) radix)))
		       (and d (aux (+ i 1) (+ (* acc radix) d))))))))

	 ((unsigned i j radix)
	  (iterate look ((k i))
	    (cond ((= k j) (digits i j radix))
		  ((eq? (nth str k) #\/)
		   (let ((num (digits i k radix))
			 (den (digits (+ k 1) j radix)))
		     (and num den (not (zero? den)) (/ num den))))
		  (else (look (+ k 1))))))

	 ((signed i j radix)
	  (cond ((= i j) #f)
		((eq? (nth str i) #\-)
		 (let ((v (unsigned (+ i 1) j radix)))
		   (and v (- v))))
		((eq? (nth str i) #\+) (unsigned (+ i 1) j radix))
		(else (unsigned i j radix))))

	 ((prefixed i j radix)
	  (if (and (< (+ i 1) j) (eq? (nth str i) #\#))
	      (let ((c (downcase (nth str (+ i 1)))))
		(cond ((eq? c #\b) (prefixed (+ i 2) j 2))
		      ((eq? c #\o) (prefixed (+ i 2) j 8))
		      ((eq? c #\d) (prefixed (+ i 2) j 10))
		      ((eq? c #\x) (prefixed (+ i 2) j 16))
		      ((eq? c #\e) (prefixed (+ i 2) j radix))
		      ((eq? c #\i) (prefixed (+ i 2) j radix))
		      (else #f)))
	      (signed i j radix))))

      (prefixed 0 end radix))))

(define (string->number str . radix)
  (if (zero? (rest-length radix))
      (%string->number str 10)
      (%string->number str . radix)))

