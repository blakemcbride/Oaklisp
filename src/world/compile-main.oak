;;; The compiler as a stand-alone executable, for check-executable-
;;; fixpoint: oakc compile-main.oak --eval '(compile-from-argline)'
;;; makes a program that compiles one source, given after a -- on its
;;; command line as LOCALE TARGET OUTDIR SOURCE, as --locale, --target,
;;; --outdir and --compile would.  LOCALE is system-locale or
;;; compiler-locale.

(define (compile-from-argline)
  (let* ((args (cdr (member "--" (get-argline))))
	 (args (if (and args (equal? (car args) "--")) (cdr args) args)))
    (destructure (loc target outdir src) args
      (set! #*target-architecture (parse-architecture-name target))
      (set! #*compiler-output-directory outdir)
      (bind ((#*compiler-noisiness 0))
	(compile-file (if (equal? loc "compiler-locale")
			  compiler-locale
			  system-locale)
		      src)))))
