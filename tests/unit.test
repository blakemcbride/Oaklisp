#!/bin/sh
# The unit testing framework in doc/examples, with src/misc's self-tests
# and the bank example's tests, run in system-locale and in user-locale.
. "$(dirname "$0")/testlib.sh"
ex="$top_srcdir/doc/examples"
for loc in system-locale user-locale; do
  out=$(oak -- --locale $loc --load "$ex/unit-testing" \
	--load "$top_srcdir/src/misc/testing-tests" \
	--load "$ex/bank-example" --load "$ex/test-bank-example" \
	--eval "(run-all-tests unit-tests)" --exit 2>&1)
  status=$?
  echo "$out"
  test "$status" = 0 || fail "unit tests in $loc: exit status $status"
  printf '%s\n' "$out" | grep -q '\*\*\* \|An error occurred' && fail "unit tests in $loc reported failures"
  test "$(printf '%s\n' "$out" | grep -c 'Completed Tests for')" = 3 || fail "unit tests in $loc did not complete"
  printf '%s\n' "$out" | grep -q 'TOTAL FAILED:     0' || fail "unit tests in $loc: failures counted"
  printf '%s\n' "$out" | grep -q 'TOTAL EXCEPTIONS: 0' || fail "unit tests in $loc: exceptions counted"
done
echo "unit tests pass in system-locale and user-locale"
