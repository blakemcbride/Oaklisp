;;; The same work on N OS threads: BENCH-COPIES calls of WORK, each on
;;; a thread of its own when the emulator has threads and BENCH-THREADS
;;; is more than 1, all on the one thread otherwise.  "bench.sh -p N"
;;; sets BENCH-COPIES and BENCH-THREADS to N for one run and
;;; BENCH-THREADS to 1 for another, times both by the wall clock and
;;; reports the speed-up.

(define (tak x y z)
  (if (not (< y x)) z
      (tak (tak (- x 1) y z) (tak (- y 1) z x) (tak (- z 1) x y))))

(define (work k)
  (let loop ((i 0) (s 0))
    (if (= i 3) (+ s k) (loop (+ i 1) (+ s (tak 24 16 8))))))

(define bench-copies 4)
(define bench-threads 4)

(define (bench)
  (let ((ks (let loop ((k bench-copies) (acc '()))
	      (if (= k 0) acc (loop (- k 1) (cons k acc))))))
    (if (and (%threads-enabled?) (> bench-threads 1))
	(apply + (map thread-join
		      (map (lambda (k) (make-thread (lambda () (work k)))) ks)))
	(apply + (map work ks)))))
